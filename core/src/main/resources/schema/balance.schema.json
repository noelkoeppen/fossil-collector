{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noelkoeppen.de/fossil-collector/schema/balance.schema.json",
  "title": "balance.json",
  "type": "object",
  "properties": {
    "qualityTiers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "minQuality": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "color": {
            "$ref": "common.schema.json#/$defs/color"
          }
        },
        "required": [
          "id",
          "minQuality",
          "color"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "statLimits": {
      "type": "object",
      "propertyNames": {
        "$ref": "common.schema.json#/$defs/statId"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    "finds": {
      "type": "object",
      "description": "Fundsystem (Kapitel 4): Verteilung der Fundgroesse, Grundqualitaet, Abweichung pro Knochen",
      "properties": {
        "sizeWeights": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "size": {
                "type": "integer",
                "minimum": 1
              },
              "weight": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "size",
              "weight"
            ],
            "additionalProperties": false
          }
        },
        "baseQualityMin": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "baseQualityMax": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "boneQualityDeviation": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "sizeWeights",
        "baseQualityMin",
        "baseQualityMax",
        "boneQualityDeviation"
      ],
      "additionalProperties": false
    },
    "excavation": {
      "type": "object",
      "description": "Grabungsflaeche (Kapitel 3, AP2-05): Raster, Erdtiefe, Hinweise, Platzierung der Funde",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "description": "Breite des internen Rasters in Zellen"
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "description": "Hoehe des internen Rasters in Zellen"
        },
        "depthMin": {
          "type": "integer",
          "minimum": 1,
          "description": "Kleinste Erdtiefe einer Zelle (Erdeinheiten)"
        },
        "depthMax": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "Groesste Erdtiefe einer Zelle (Erdeinheiten)"
        },
        "hintDepth": {
          "type": "integer",
          "minimum": 1,
          "description": "Hinweis, sobald hoechstens so viel Erde ueber einem Knochen liegt; kleiner als depthMin"
        },
        "findCountWeights": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "count": {
                "type": "integer",
                "minimum": 1
              },
              "weight": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "count",
              "weight"
            ],
            "additionalProperties": false
          }
        },
        "findSpacing": {
          "type": "integer",
          "minimum": 0,
          "description": "Mindestabstand zwischen Zellen verschiedener Funde (Chebyshev, Zellen)"
        },
        "placementAttempts": {
          "type": "integer",
          "minimum": 1,
          "description": "Versuche pro Fund, danach wird er weggelassen"
        },
        "placeholderFootprint": {
          "type": "object",
          "description": "Uebergang bis AP2-06: Rechteck pro Knochen in Zellen",
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "width",
            "height"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "width",
        "height",
        "depthMin",
        "depthMax",
        "hintDepth",
        "findCountWeights",
        "findSpacing",
        "placementAttempts",
        "placeholderFootprint"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "qualityTiers",
    "statLimits",
    "finds",
    "excavation"
  ],
  "additionalProperties": false
}
