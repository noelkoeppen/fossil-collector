{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noelkoeppen.de/fossil-collector/schema/balance.schema.json",
  "title": "balance.json",
  "type": "object",
  "properties": {
    "qualityTiers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "minQuality": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "color": {
            "$ref": "common.schema.json#/$defs/color"
          }
        },
        "required": [
          "id",
          "minQuality",
          "color"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "statLimits": {
      "type": "object",
      "propertyNames": {
        "$ref": "common.schema.json#/$defs/statId"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    "finds": {
      "type": "object",
      "description": "Fundsystem (Kapitel 4): Verteilung der Fundgroesse, Grundqualitaet, Abweichung pro Knochen",
      "properties": {
        "sizeWeights": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "size": {
                "type": "integer",
                "minimum": 1
              },
              "weight": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "size",
              "weight"
            ],
            "additionalProperties": false
          }
        },
        "baseQualityMin": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "baseQualityMax": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "boneQualityDeviation": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "sizeWeights",
        "baseQualityMin",
        "baseQualityMax",
        "boneQualityDeviation"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "qualityTiers",
    "statLimits",
    "finds"
  ],
  "additionalProperties": false
}
