{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noelkoeppen.de/fossil-collector/schema/balance.schema.json",
  "title": "balance.json",
  "type": "object",
  "properties": {
    "qualityTiers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "minQuality": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "color": {
            "$ref": "common.schema.json#/$defs/color"
          }
        },
        "required": [
          "id",
          "minQuality",
          "color"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "statLimits": {
      "type": "object",
      "propertyNames": {
        "$ref": "common.schema.json#/$defs/statId"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          }
        },
        "required": [],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "qualityTiers",
    "statLimits"
  ],
  "additionalProperties": false
}
