{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noelkoeppen.de/fossil-collector/schema/balance.schema.json",
  "title": "balance.json",
  "type": "object",
  "properties": {
    "qualityTiers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "minQuality": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "color": {
            "$ref": "common.schema.json#/$defs/color"
          }
        },
        "required": [
          "id",
          "minQuality",
          "color"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "statLimits": {
      "type": "object",
      "propertyNames": {
        "$ref": "common.schema.json#/$defs/statId"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    "finds": {
      "type": "object",
      "description": "Fundsystem (Kapitel 4): Verteilung der Fundgroesse, Grundqualitaet, Abweichung pro Knochen",
      "properties": {
        "sizeWeights": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "size": {
                "type": "integer",
                "minimum": 1
              },
              "weight": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "size",
              "weight"
            ],
            "additionalProperties": false
          }
        },
        "baseQualityMin": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "baseQualityMax": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "boneQualityDeviation": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "sizeWeights",
        "baseQualityMin",
        "baseQualityMax",
        "boneQualityDeviation"
      ],
      "additionalProperties": false
    },
    "excavation": {
      "type": "object",
      "description": "Grabungsflaeche (Kapitel 3, AP2-05): Raster, Erdtiefe, Hinweise, Platzierung der Funde",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "description": "Breite des internen Rasters in Zellen"
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "description": "Hoehe des internen Rasters in Zellen"
        },
        "depthMin": {
          "type": "integer",
          "minimum": 1,
          "description": "Kleinste Erdtiefe einer Zelle (Erdeinheiten)"
        },
        "depthMax": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "Groesste Erdtiefe einer Zelle (Erdeinheiten)"
        },
        "hintDepth": {
          "type": "integer",
          "minimum": 1,
          "description": "Hinweis, sobald hoechstens so viel Erde ueber einem Knochen liegt; kleiner als depthMin"
        },
        "findCountWeights": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "count": {
                "type": "integer",
                "minimum": 1
              },
              "weight": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "count",
              "weight"
            ],
            "additionalProperties": false
          }
        },
        "findSpacing": {
          "type": "integer",
          "minimum": 0,
          "description": "Mindestabstand zwischen Zellen verschiedener Funde (Chebyshev, Zellen)"
        },
        "placementAttempts": {
          "type": "integer",
          "minimum": 1,
          "description": "Versuche pro Fund, danach wird er weggelassen"
        },
        "cellsPerUnit": {
          "type": "integer",
          "minimum": 1,
          "description": "Zellen pro Modelleinheit fuer die Knochenumrisse aus den Masken (AP2-07); bone_footprints.py liest den Wert von hier"
        }
      },
      "required": [
        "width",
        "height",
        "depthMin",
        "depthMax",
        "hintDepth",
        "findCountWeights",
        "findSpacing",
        "placementAttempts",
        "cellsPerUnit"
      ],
      "additionalProperties": false
    },
    "preparation": {
      "type": "object",
      "description": "Feines Freilegen (Kapitel 5.1, AP2-08): feines Raster, Restschicht mit losen und harten Stellen, Schwelle fuer fertig",
      "properties": {
        "subdivision": {
          "type": "integer",
          "minimum": 1,
          "description": "Feine Zellen je Zelle und Achse; bone_footprints.py liest den Wert von hier"
        },
        "margin": {
          "type": "integer",
          "minimum": 0,
          "description": "Rand um das Rechteck des Knochens in Zellen der Flaeche"
        },
        "looseDepthMin": {
          "type": "integer",
          "minimum": 1,
          "maximum": 127,
          "description": "Kleinste Dicke loser Erde (Einheiten der Restschicht)"
        },
        "looseDepthMax": {
          "type": "integer",
          "minimum": 1,
          "maximum": 127,
          "description": "Groesste Dicke loser Erde"
        },
        "hardDepthMin": {
          "type": "integer",
          "minimum": 1,
          "maximum": 127,
          "description": "Kleinste Dicke einer harten Stelle"
        },
        "hardDepthMax": {
          "type": "integer",
          "minimum": 1,
          "maximum": 127,
          "description": "Groesste Dicke einer harten Stelle"
        },
        "hardSpotsPerCell": {
          "type": "number",
          "minimum": 0,
          "description": "Mittlere Anzahl harter Stellen je Zelle des Knochens in der Flaeche"
        },
        "hardSpotRadiusMin": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Kleinster Radius einer harten Stelle in feinen Zellen"
        },
        "hardSpotRadiusMax": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Groesster Radius einer harten Stelle in feinen Zellen"
        },
        "finishedShare": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "description": "Anteil freiliegender Knochenzellen, ab dem der Knochen fertig freigelegt ist"
        }
      },
      "required": [
        "subdivision",
        "margin",
        "looseDepthMin",
        "looseDepthMax",
        "hardDepthMin",
        "hardDepthMax",
        "hardSpotsPerCell",
        "hardSpotRadiusMin",
        "hardSpotRadiusMax",
        "finishedShare"
      ],
      "additionalProperties": false
    },
    "recovery": {
      "type": "object",
      "description": "Bergen (Kapitel 5.2, AP2-09): bruechige Stellen, Sichern mit Gips, Bewertung der Hebebewegung",
      "properties": {
        "fragileSpotsPerCell": {
          "type": "number",
          "minimum": 0,
          "description": "Mittlere Anzahl bruechiger Stellen je Zelle des Knochens in der Flaeche"
        },
        "fragileSpotsMin": {
          "type": "integer",
          "minimum": 0,
          "description": "Mindestanzahl bruechiger Stellen je Knochen (sofern Platz ist)"
        },
        "fragileSpotsMax": {
          "type": "integer",
          "minimum": 0,
          "description": "Hoechstanzahl bruechiger Stellen je Knochen"
        },
        "fragileSpotSpacing": {
          "type": "number",
          "minimum": 0,
          "description": "Mindestabstand zweier bruechiger Stellen in feinen Zellen"
        },
        "secureRadius": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Trefferradius beim Sichern (Antippen) in feinen Zellen"
        },
        "liftDistance": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Zugweg in dp, ab dem der Knochen herausgehoben ist"
        },
        "sampleWindowMillis": {
          "type": "integer",
          "minimum": 1,
          "description": "Laenge eines Bewertungsfensters der Bewegung in Millisekunden"
        },
        "jerkSpeedChange": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Geschwindigkeitswechsel zwischen zwei Fenstern in dp/s, ab dem ein Ruck vorliegt"
        },
        "maxSpeed": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Geschwindigkeit in dp/s, ab der die Bewegung als Ruck zaehlt"
        },
        "jerkDamage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Qualitaetsverlust je Ruck vor damage_reduction"
        },
        "unsecuredDamage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Qualitaetsverlust je ungesicherter Stelle beim Herausheben vor damage_reduction"
        }
      },
      "required": [
        "fragileSpotsPerCell",
        "fragileSpotsMin",
        "fragileSpotsMax",
        "fragileSpotSpacing",
        "secureRadius",
        "liftDistance",
        "sampleWindowMillis",
        "jerkSpeedChange",
        "maxSpeed",
        "jerkDamage",
        "unsecuredDamage"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "qualityTiers",
    "statLimits",
    "finds",
    "excavation",
    "preparation",
    "recovery"
  ],
  "additionalProperties": false
}
