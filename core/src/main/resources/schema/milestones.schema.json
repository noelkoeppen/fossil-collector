{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noelkoeppen.de/fossilcollector/schema/milestones.schema.json",
  "title": "Meilensteine (milestones.json)",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "condition": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "enum": [
              "pieces_found",
              "skeletons_completed",
              "pristine_found",
              "teams_total",
              "layers_unlocked",
              "reconstructions",
              "prestige_count"
            ]
          },
          "value": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "type",
          "value"
        ]
      },
      "reward": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "money": {
            "type": "number",
            "minimum": 0
          },
          "researchPoints": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [],
        "minProperties": 1
      }
    },
    "required": [
      "id",
      "condition",
      "reward"
    ]
  }
}
