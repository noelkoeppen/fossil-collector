{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noelkoeppen.de/fossil-collector/schema/skilltree.schema.json",
  "title": "skilltree.json",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "branch": {
        "enum": [
          "dig",
          "prep",
          "lab",
          "curator",
          "expedition"
        ]
      },
      "depth": {
        "type": "integer",
        "minimum": 1
      },
      "baseCost": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "requires": {
        "type": "array",
        "items": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "uniqueItems": true
      },
      "capstone": {
        "type": "boolean"
      },
      "effects": {
        "type": "array",
        "items": {
          "$ref": "common.schema.json#/$defs/modifier"
        },
        "minItems": 1
      }
    },
    "required": [
      "id",
      "branch",
      "depth",
      "baseCost",
      "effects"
    ],
    "additionalProperties": false
  },
  "minItems": 1
}
