{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noelkoeppen.de/fossil-collector/schema/skeleton.schema.json",
  "title": "skeletons/skeleton_<name>.json (erzeugt von tools/svg2json.py)",
  "type": "object",
  "properties": {
    "name": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "viewBox": {
      "type": "object",
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      },
      "required": ["x", "y", "width", "height"],
      "additionalProperties": false
    },
    "bones": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "zones": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "$ref": "common.schema.json#/$defs/id"
                },
                "d": {
                  "type": "string",
                  "pattern": "^[Mm]"
                }
              },
              "required": ["id", "d"],
              "additionalProperties": false
            },
            "minItems": 1
          }
        },
        "required": ["id", "zones"],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": ["name", "viewBox", "bones"],
  "additionalProperties": false
}
