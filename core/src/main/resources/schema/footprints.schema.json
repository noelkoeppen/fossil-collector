{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noelkoeppen.de/fossil-collector/schema/footprints.schema.json",
  "title": "footprints/<speciesId>.json",
  "description": "Knochenumrisse einer Art im Raster der Grabungsflaeche (AP2-07), erzeugt von tools/models3d/bone_footprints.py",
  "type": "object",
  "properties": {
    "formatVersion": {
      "const": 2
    },
    "species": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "cellsPerUnit": {
      "type": "integer",
      "minimum": 1,
      "description": "muss balance.json: excavation.cellsPerUnit entsprechen"
    },
    "pxPerUnit": {
      "type": "integer",
      "minimum": 1,
      "description": "Pixel pro Modelleinheit der Knochenbilder"
    },
    "subdivision": {
      "type": "integer",
      "minimum": 1,
      "description": "feine Zellen je Zelle und Achse, muss balance.json: preparation.subdivision entsprechen (AP2-08)"
    },
    "params": {
      "type": "object",
      "properties": {
        "minCoverage": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "offsetStep": {
          "type": "integer",
          "minimum": 1
        },
        "fineCoverage": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "minCoverage",
        "offsetStep",
        "fineCoverage"
      ],
      "additionalProperties": false
    },
    "bones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "rows": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[#.]+$"
            },
            "description": "Zeilen des Umrisses von oben nach unten, # = belegt"
          },
          "imageLeft": {
            "type": "integer",
            "description": "linke Bildkante in Bildpixeln relativ zum Umriss-Rechteck"
          },
          "imageTop": {
            "type": "integer",
            "description": "obere Bildkante in Bildpixeln relativ zum Umriss-Rechteck"
          },
          "fineRows": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[#.]+$"
            },
            "description": "feiner Umriss fuer das feine Freilegen (AP2-08): Rechteck mal subdivision, # = Knochen"
          }
        },
        "required": [
          "id",
          "rows",
          "imageLeft",
          "imageTop",
          "fineRows"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "formatVersion",
    "species",
    "cellsPerUnit",
    "pxPerUnit",
    "subdivision",
    "params",
    "bones"
  ],
  "additionalProperties": false
}
