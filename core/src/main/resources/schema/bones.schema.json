{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noelkoeppen.de/fossilcollector/schema/bones.schema.json",
  "title": "Knochen (bones.json)",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "zones": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "minItems": 1,
        "uniqueItems": true
      }
    },
    "required": [
      "id",
      "zones"
    ]
  },
  "minItems": 1
}
