{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noelkoeppen.de/fossil-collector/schema/species.schema.json",
  "title": "species.json",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "layer": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "rarityWeight": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "bones": {
        "type": "array",
        "items": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "minItems": 1,
        "uniqueItems": true
      }
    },
    "required": [
      "id",
      "layer",
      "rarityWeight",
      "bones"
    ],
    "additionalProperties": false
  },
  "minItems": 1
}
