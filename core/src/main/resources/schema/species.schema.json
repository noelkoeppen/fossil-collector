{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noelkoeppen.de/fossil-collector/schema/species.schema.json",
  "title": "species.json",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "layer": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "rarityWeight": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "bones": {
        "type": "array",
        "items": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "minItems": 1,
        "uniqueItems": true,
        "description": "Einzelknochen aus art/models3d/<id>/bones.json (erzeugt von tools/models3d/neighbors.py)"
      },
      "neighbors": {
        "type": "array",
        "description": "Nachbarschaftsgraph: ungerichtete Kanten [a, b] (erzeugt von tools/models3d/neighbors.py)",
        "items": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "required": [
      "id",
      "layer",
      "rarityWeight",
      "bones",
      "neighbors"
    ],
    "additionalProperties": false
  },
  "minItems": 1
}
