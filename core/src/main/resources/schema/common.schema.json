{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noelkoeppen.de/fossil-collector/schema/common.schema.json",
  "title": "Gemeinsame Typen der Spieldaten",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "ID in snake_case"
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "statId": {
      "enum": [
        "damage_reduction",
        "quality_base_min",
        "sell_price"
      ],
      "description": "Stat-IDs des Modifier-Systems (StatId.kt)"
    },
    "modifierOp": {
      "enum": [
        "add",
        "mult"
      ]
    },
    "modifierCategory": {
      "enum": [
        "upgrade",
        "event"
      ]
    },
    "modifier": {
      "type": "object",
      "description": "Modifier-Definition",
      "properties": {
        "stat": {
          "$ref": "common.schema.json#/$defs/statId"
        },
        "op": {
          "$ref": "common.schema.json#/$defs/modifierOp"
        },
        "value": {
          "type": "number"
        },
        "category": {
          "$ref": "common.schema.json#/$defs/modifierCategory"
        }
      },
      "required": [
        "stat",
        "op",
        "value",
        "category"
      ],
      "additionalProperties": false
    },
    "modifierList": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/modifier"
      }
    }
  }
}
