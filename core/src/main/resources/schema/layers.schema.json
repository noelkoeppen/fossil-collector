{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noelkoeppen.de/fossil-collector/schema/layers.schema.json",
  "title": "layers.json",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "order": {
        "type": "integer",
        "minimum": 0
      },
      "unlockCost": {
        "type": "number",
        "minimum": 0
      },
      "teamBaseCost": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "teamGrowth": {
        "type": "number",
        "exclusiveMinimum": 1
      },
      "teamRate": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "value": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "fragility": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "fameWeight": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "color": {
        "$ref": "common.schema.json#/$defs/color"
      }
    },
    "required": [
      "id",
      "order",
      "unlockCost",
      "teamBaseCost",
      "teamGrowth",
      "teamRate",
      "value",
      "fragility",
      "fameWeight",
      "color"
    ],
    "additionalProperties": false
  },
  "minItems": 1
}
