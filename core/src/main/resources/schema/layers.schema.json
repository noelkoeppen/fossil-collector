{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noelkoeppen.de/fossil-collector/schema/layers.schema.json",
  "title": "layers.json",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "order": {
        "type": "integer",
        "minimum": 0
      },
      "color": {
        "$ref": "common.schema.json#/$defs/color"
      },
      "texture": {
        "description": "Gesteinstextur der Schicht (AP-26); Standard plain",
        "enum": [
          "plain",
          "gravel",
          "banded",
          "chalk"
        ]
      }
    },
    "required": [
      "id",
      "order",
      "color"
    ],
    "additionalProperties": false
  },
  "minItems": 1
}
